{
  "name": "valheim-dashboard",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "check": "pnpm -r --if-present run check",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "coverage": "pnpm -r --if-present run coverage",
    "coverage:report": "node packages/coverage-report/src/main.ts apps/dashboard packages/valheim-log packages/coverage-report scripts",
    "build": "pnpm -r --if-present run build"
  }
}
