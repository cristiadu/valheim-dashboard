{
  "name": "valheim-log",
  "version": "0.1.0",
  "description": "Reads a Valheim dedicated server's logs.txt into game events and player sessions, line by line.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.13.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "imports": {
    "#/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  }
}
