{
  "name": "valheim-log",
  "version": "0.1.0",
  "description": "Reads a Valheim dedicated server's logs.txt into game events and player sessions, line by line.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "imports": {
    "#/*": "./src/*.ts",
    "#test/*": "./test/*.ts"
  }
}
